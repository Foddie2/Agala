# Copy to .env (never commit .env) and fill in. Used by POST /api/contact.
#
# Gmail example: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password

# Where contact-form messages are delivered.
CONTACT_TO=you@gmail.com
# Optional sender address (defaults to SMTP_USER).
CONTACT_FROM=
